{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seq23/search-loop/schema/search-loop-week-v1.json",
  "title": "search-loop-week-v1",
  "description": "One site, one run of the search loop, the last 7 days. Uploaded as the Actions artifact search-loop-week on every run. A metric whose source could not be read is the string \"not read: <reason>\", never 0.",
  "type": "object",
  "required": [
    "schema",
    "site",
    "generated_at",
    "state",
    "published",
    "indexed",
    "pace",
    "ai_visitors",
    "ai_bot_hits",
    "conversions",
    "wins",
    "undone",
    "merged",
    "held_by_cap",
    "redirected",
    "cap",
    "notes",
    "run_url"
  ],
  "properties": {
    "schema": {
      "const": "search-loop-week-v1"
    },
    "week": {
      "type": "string",
      "description": "ISO week on America/Chicago"
    },
    "site": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "running",
        "slow",
        "off",
        "stopped"
      ],
      "description": "running = normal mode; slow / off = the throttle; stopped = a named stop (see notes)"
    },
    "published": {
      "type": "integer",
      "minimum": 0,
      "description": "new pages published in the last 7 days"
    },
    "indexed": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^not read: .+"
        }
      ],
      "description": "engine pages Search Console reports indexed (URL Inspection)"
    },
    "pace": {
      "type": "integer",
      "minimum": 0,
      "description": "pages the engine may publish per day after the mode (cap.max_per_day, 3 in slow, 0 when off); a run guard, not a pace: the outcome-gated cap is in cap"
    },
    "ai_visitors": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^not read: .+"
        }
      ],
      "description": "visits referred by AI answer engines, by referrer hostname only, last 7 days"
    },
    "ai_bot_hits": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^not read: .+"
        }
      ],
      "description": "requests from AI crawlers/fetchers, last 7 days"
    },
    "conversions": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^not read: .+"
        }
      ],
      "description": "form fills / checkouts"
    },
    "wins": {
      "type": "integer",
      "minimum": 0
    },
    "undone": {
      "type": "integer",
      "minimum": 0
    },
    "merged": {
      "type": "integer",
      "minimum": 0
    },
    "held_by_cap": {
      "type": "integer",
      "minimum": 0,
      "description": "pages the day's limit allowed in the last 7 days that the per-site cap held back (their searches stay queued)"
    },
    "redirected": {
      "type": "array",
      "description": "searches in the last 7 days with the same intent as an existing page: no new page, a strengthen brief for that page instead",
      "items": {
        "type": "object",
        "required": [
          "query",
          "strengthen"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "strengthen": {
            "type": "string",
            "description": "the existing page's URL"
          },
          "matched_by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "cap": {
      "type": "object",
      "required": [
        "max_live_pages",
        "why"
      ],
      "description": "the per-site cap on live engine pages and why it is where it is",
      "properties": {
        "max_live_pages": {
          "type": "integer",
          "minimum": 0
        },
        "live": {
          "type": "integer",
          "minimum": 0
        },
        "room": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "lanes": {
      "type": "object",
      "description": "v1.6.0 (optional; older engines omit it): the two lanes. can_be_one = picked by a competition score; striking = already ranks 8-30. hit_rate = share of pages measured at 2/4/8 weeks that reached the top 3. weights = this site's can-be-#1 weights; weight_changes = the logged adjustments.",
      "properties": {
        "ratio": {
          "type": "object"
        },
        "can_be_one": {
          "type": "object",
          "required": [
            "pages",
            "measured",
            "top3",
            "hit_rate"
          ],
          "properties": {
            "pages": {
              "type": "integer",
              "minimum": 0
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "top3": {
              "type": "integer",
              "minimum": 0
            },
            "hit_rate": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "string",
                  "pattern": "^not read: "
                }
              ]
            }
          }
        },
        "striking": {
          "type": "object",
          "required": [
            "pages",
            "measured",
            "top3",
            "hit_rate"
          ],
          "properties": {
            "pages": {
              "type": "integer",
              "minimum": 0
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "top3": {
              "type": "integer",
              "minimum": 0
            },
            "hit_rate": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "string",
                  "pattern": "^not read: "
                }
              ]
            }
          }
        },
        "weights": {
          "type": "object"
        },
        "weight_changes": {
          "type": "array"
        },
        "competition": {
          "type": "string"
        }
      }
    }
  }
}
